// 数据库连接配置
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 客户端生成配置
generator client {
  provider = "prisma-client-js"
}

// 员工模型：测试模型
model Employee {
  id         Int      @id @default(autoincrement()) // 自增 ID
  name       String                                   // 员工姓名
  department String                                   // 部门名称
  createdAt  DateTime @default(now())               // 创建时间
}
