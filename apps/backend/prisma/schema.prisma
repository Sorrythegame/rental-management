// 数据库连接配置
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 客户端生成配置
generator client {
  provider = "prisma-client-js"
}

// 管理员
model Admin {
  id           Int      @id @default(autoincrement()) // 自增 ID
  username     String   @unique                       // 用户名
  passwordHash String                                 // 密码 Hash
}

// 品牌字典
model Brand {
  id           Int           @id @default(autoincrement()) // 自增 ID
  name         String        @unique                       // 品牌名称
  deviceModels DeviceModel[]                               // 关联的型号
  assets       Asset[]                                     // 关联的资产
}

// 型号字典
model DeviceModel {
  id      Int     @id @default(autoincrement()) // 自增 ID
  name    String                                // 型号名称
  brandId Int                                   // 关联的品牌 ID
  brand   Brand   @relation(fields: [brandId], references: [id])
  assets  Asset[]                               // 关联的资产

  @@unique([brandId, name]) // 同一品牌下型号名称唯一
}

enum AssetType {
  Camera    // 相机
  Accessory // 配件
}

enum AssetStatus {
  Normal  // 正常
  Damaged // 损坏
}

enum RentalStatus {
  Rented    // 出租中
  Available // 未出租
}

// 核心资产表
model Asset {
  id           Int          @id @default(autoincrement()) // 自增 ID
  type         AssetType                                   // 资产类型
  name         String?                                     // 配件名称（仅配件用）
  sinCode      String?   @map("snCode")                        // SIN 码（仅相机用）
  brandId      Int?                                        // 品牌 ID（配件可空）
  brand        Brand?       @relation(fields: [brandId], references: [id])
  modelId      Int?                                        // 型号 ID（配件可空）
  model        DeviceModel? @relation(fields: [modelId], references: [id])
  imageUrls    Json                                        // 资产图片链接列表（JSON 数组）
  purchaseDate DateTime                                    // 购买时间
  price        Float                                       // 购买金额
  status       AssetStatus                                 // 设备状态
  damageDesc   String?                                     // 损坏描述
  rentalStatus RentalStatus @default(Available)            // 出租状态
  remark                String?                                     // 备注
  orders                RentalOrder[]                               // 关联订单（相机）
  orderAccessories      RentalOrderAccessory[]                      // 关联订单（配件）
  reservations          Reservation[]                               // 关联预定（相机）
  reservationAccessories ReservationAccessory[]                     // 关联预定（配件）
}

enum OrderStatus {
  NotStarted      // 未开始
  InProgress      // 进行中
  Completed       // 已完成
  ManuallyStopped // 手动停止
}

enum ReservationStatus {
  Pending    // 待确认
  Confirmed  // 已确认
  Cancelled  // 已取消
  Converted  // 已转单
}

// 租赁订单表
model RentalOrder {
  id               Int                    @id @default(autoincrement()) // 自增 ID
  assetId          Int?                                            // 关联资产 ID（相机）
  asset            Asset?                 @relation(fields: [assetId], references: [id])
  sinCode          String?                @map("snCode")            // 设备 SIN 码
  brandName        String?                                         // 设备品牌（快照）
  modelName        String?                                         // 设备型号/名称（快照）
  name             String?                                         // 订单名称
  startTime        DateTime                                        // 租赁开始时间
  endTime          DateTime                                        // 租赁结束时间
  orderStatus      OrderStatus            @default(NotStarted)     // 订单状态
  amount           Float                                           // 订单金额
  customerName     String?                                         // 客户名
  customerPhone    String?                                         // 客户电话
  remarks          String?                                         // 备注
  accessories      RentalOrderAccessory[]                          // 关联配件
  reservations     Reservation[]                                   // 由预定转来的订单
}

// 订单配件关联表
model RentalOrderAccessory {
  id            Int         @id @default(autoincrement())
  rentalOrderId Int
  assetId       Int
  rentalOrder   RentalOrder @relation(fields: [rentalOrderId], references: [id], onDelete: Cascade)
  asset         Asset       @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([rentalOrderId, assetId])
}

// 预定表
model Reservation {
  id            Int                    @id @default(autoincrement())
  assetId       Int?                                            // 关联资产 ID（相机）
  asset         Asset?                 @relation(fields: [assetId], references: [id])
  sinCode       String?                @map("snCode")            // 设备 SIN 码
  brandName     String?                                         // 设备品牌（快照）
  modelName     String?                                         // 设备型号/名称（快照）
  name          String?                                         // 预定名称
  startTime     DateTime                                        // 预定开始时间
  endTime       DateTime                                        // 预定结束时间
  status        ReservationStatus      @default(Pending)         // 预定状态
  amount        Float                                           // 预计金额
  deposit       Float?                                          // 押金
  customerName  String?                                         // 客户名
  customerPhone String?                                         // 客户电话
  remarks       String?                                         // 备注
  rentalOrderId Int?                                            // 转单后关联的正式订单
  rentalOrder   RentalOrder?           @relation(fields: [rentalOrderId], references: [id])
  accessories   ReservationAccessory[]                          // 关联配件
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
}

// 预定配件关联表
model ReservationAccessory {
  id            Int         @id @default(autoincrement())
  reservationId Int
  assetId       Int
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  asset         Asset       @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([reservationId, assetId])
}
